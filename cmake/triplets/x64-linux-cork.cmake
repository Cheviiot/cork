# Триплет vcpkg для cork.
#
# От встроенного x64-linux отличается тем, что здесь мы фиксируем связывание
# явно, а не полагаемся на умолчание vcpkg: поставляемый бинарник должен быть
# максимально статическим, иначе он не заработает на дистрибутиве старше того,
# на котором собран. Динамической остаётся только glibc.
#
# Отдельный файл, а не правка встроенного триплета, нужен ещё и затем, чтобы
# было куда положить будущие настройки под curl[c-ares] и OpenSSL — статическое
# разрешение имён через NSS это отдельная история, см. эксперимент 12 в плане.

set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)

set(VCPKG_CMAKE_SYSTEM_NAME Linux)
